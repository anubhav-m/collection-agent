# Copy to .env in the project root and fill in real values. Never commit .env.
GEMINI_MODEL=gemini-model-name
GEMINI_API_KEY_1=your-first-gemini-key
GEMINI_API_KEY_2=your-optional-backup-key
GEMINI_API_KEY_3=your-optional-second-backup-key
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=collections_agent
LLM_REQUESTS_PER_MINUTE=10
LLM_CACHE_ENABLED=false
LOG_LEVEL=INFO
# Public-demo safeguards for POST /chat
CHAT_REQUESTS_PER_MINUTE_PER_IP=8
LLM_DAILY_CALL_CAP=200
